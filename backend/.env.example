# Copy to .env. Shell variables take precedence; the app loads .env if present.
RESEARCH_MODEL=google_genai:gemini-3.5-flash
# Set RESEARCH_MODEL=demo for the deterministic, credential-free integration demo.
# GOOGLE_API_KEY=
# To use SeekAI instead, replace RESEARCH_MODEL above and set these values:
# RESEARCH_MODEL=openai:qwen3.8-flash
# RESEARCH_MODEL_BASE_URL=https://seekai.cc/v1
# RESEARCH_MODEL_API_KEY=your-seekai-api-key
# Embeddings are independent of the chat provider. Live default uses GOOGLE_API_KEY.
# RESEARCH_EMBEDDING_MODEL=google_genai:gemini-embedding-001
# For an OpenAI-compatible embedding service, specify its supported model and key:
# RESEARCH_EMBEDDING_MODEL=openai:text-embedding-3-small
# RESEARCH_EMBEDDING_API_KEY=your-embedding-provider-key
# RESEARCH_EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
# RESEARCH_MODEL=demo always uses offline lexical embeddings.
RESEARCH_PROJECT_ID=research-demo
# Paths default to this repository's data directory, independent of cwd.
# RESEARCH_DB_PATH=/absolute/path/memory.sqlite3
# RESEARCH_PAPERS_DIR=/absolute/path/papers
RESEARCH_MEMORY_BUDGET=2000
LANGSMITH_TRACING=false
